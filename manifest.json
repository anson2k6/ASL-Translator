{
  "manifest_version": 3,
  "name": "ASL Meet Assistant",
  "version": "1.0",
  "description": "Real-time ASL sign detection during Google Meet calls",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "inject_camera_overlay.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "chatbot.js",
        "responses.json",
        "mediapipe/*",
        "ai_detection_server.py",
        "asl_letter_model.pkl",
        "gesture_model.h5",
        "landmarks_data.csv"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}